# Database
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host:port/database?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3001"

# Shopify
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxx"
SHOPIFY_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SHOPIFY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SHOPIFY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Super Admin (Initial Setup)
SUPER_ADMIN_EMAIL="admin@zicabella.com"
SUPER_ADMIN_PASSWORD="ChooseAStrongPassword123!"

# Social Auth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
APPLE_ID="your-apple-id"
APPLE_SECRET="your-apple-secret"

# Payments (Razorpay)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxx"

# Logistics (Delhivery)
DELHIVERY_API_KEY="xxxxxxxxxxxxxxxx"
DELHIVERY_BASE_URL="https://track.delhivery.com"
DELHIVERY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxx" # Must exactly match the secret registered with Delhivery for client code 09-ZICABELLAPRIVATELIMI-do-cdp. Takes priority over Shop.webhookSecret in DB — keep both in sync or unset one.

# Communications (Twilio)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxx"

# Communications (Zoho)
ZOHO_MAIL_USER="noreply@yourdomain.com"
ZOHO_MAIL_PASS="your-app-specific-password"
ZOHO_API_CLIENT_ID="your-client-id"
ZOHO_API_CLIENT_SECRET="your-client-secret"
ZOHO_API_REFRESH_TOKEN="your-refresh-token"

# APNs Push Notifications
APNS_KEY_ID="XXXXXXXXXX"
APNS_TEAM_ID="XXXXXXXXXX"
APNS_BUNDLE_ID="com.yourdomain.ios"
APNS_PRODUCTION="false"
APNS_KEY_BASE64="your-p8-key-base64-encoded"

# Other
ADMIN_NOTIFICATION_EMAIL="admin@yourdomain.com"
VENDOR_NOTIFICATION_EMAIL="vendors@yourdomain.com"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
CLAUDE_API_KEY="sk-ant-xxxxxxxxxxxxxxxx"

# OpenAI Configuration (for User-Side Zica AI mobile chat)
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4o" # or gpt-4o-mini
OPENAI_WEBHOOK_SECRET="your-openai-webhook-secret-or-none"

# WhatsApp Cloud API Integration
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-whatsapp-business-account-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-whatsapp-webhook-verify-token"
WHATSAPP_API_VERSION="v20.0"

# Meta Pixel & Conversions API
NEXT_PUBLIC_META_PIXEL_ID="your-meta-pixel-id"
META_PIXEL_ID="your-meta-pixel-id"
META_CAPI_ACCESS_TOKEN="your-system-user-access-token"
# META_TEST_EVENT_CODE="TEST12345"  # Uncomment for test mode only
# ENABLE_META_EVENTS="true"  # Enable server-side Meta event forwarding

