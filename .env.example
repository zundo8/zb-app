# Database
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host:port/database?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3001"

# Shopify
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxx"
SHOPIFY_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SHOPIFY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SHOPIFY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Super Admin (Initial Setup)
SUPER_ADMIN_EMAIL="admin@zicabella.com"
SUPER_ADMIN_PASSWORD="ChooseAStrongPassword123!"

# Social Auth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
APPLE_ID="your-apple-id"
APPLE_SECRET="your-apple-secret"

# Payments (Razorpay)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxx"

# Logistics (Delhivery)
DELHIVERY_API_KEY="xxxxxxxxxxxxxxxx"
DELHIVERY_BASE_URL="https://track.delhivery.com"

# Communications (Twilio)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxx"

# Communications (Zoho)
ZOHO_MAIL_USER="noreply@yourdomain.com"
ZOHO_MAIL_PASS="your-app-specific-password"
ZOHO_API_CLIENT_ID="your-client-id"
ZOHO_API_CLIENT_SECRET="your-client-secret"
ZOHO_API_REFRESH_TOKEN="your-refresh-token"

# APNs Push Notifications
APNS_KEY_ID="XXXXXXXXXX"
APNS_TEAM_ID="XXXXXXXXXX"
APNS_BUNDLE_ID="com.yourdomain.ios"
APNS_PRODUCTION="false"
APNS_KEY_BASE64="your-p8-key-base64-encoded"

# Other
