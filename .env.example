# Zica Bella Mobile - Environment Configuration Example
# Copy this file to .env and fill in the values

# Sentry DSN for error reporting
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# API Base URL (Production)
EXPO_PUBLIC_API_URL=https://api.zicabella.com

# Shopify Storefront Access Token
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_token_here

# Apple Merchant ID (For Apple Pay)
EXPO_PUBLIC_APPLE_MERCHANT_ID=merchant.com.zicabella.app

# Claude AI API Key (for Zica AI Operations Engine)
CLAUDE_API_KEY=your_anthropic_api_key_here

# Zoho Mail API Configuration (for Email Notifications)
ZOHO_MAIL_CLIENT_ID=your_client_id
ZOHO_MAIL_CLIENT_SECRET=your_client_secret
ZOHO_MAIL_REFRESH_TOKEN=your_refresh_token
ZOHO_MAIL_ACCOUNT_ID=your_account_id
ZOHO_MAIL_FROM_ADDRESS=admin@zicabella.com
ZOHO_ADMIN_EMAILS=admin@zicabella.com,manager@zicabella.com
ZOHO_MAIL_API_BASE=https://mail.zoho.in
ZOHO_MAIL_AUTH_BASE=https://accounts.zoho.in

# Twilio Configuration (for SMS OTP & Marketing)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
TWILIO_MESSAGING_SERVICE_SID=optional_messaging_service_sid
