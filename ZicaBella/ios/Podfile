require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def ccache_enabled?(podfile_properties)
  # Environment variable takes precedence
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']

  # Fall back to Podfile properties
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

def patch_rnfb_messaging_for_modular_headers!(installation_root)
  messaging_root = File.join(
    installation_root,
    '..',
    'node_modules',
    '@react-native-firebase',
    'messaging',
    'ios',
    'RNFBMessaging'
  )

  replacements = {
    File.join(messaging_root, 'RNFBMessaging+AppDelegate.h') => [
      [
        "#import <Foundation/Foundation.h>\n#import <React/RCTBridgeModule.h>\n#import <UIKit/UIKit.h>",
        "#import <Foundation/Foundation.h>\n#import <RNFBApp/RNFBAppModule.h>\n#import <React/RCTBridgeModule.h>\n#import <UIKit/UIKit.h>"
      ]
    ],
    File.join(messaging_root, 'RNFBMessaging+AppDelegate.m') => [
      [
        "#import <Firebase/Firebase.h>\n#import <GoogleUtilities/GULAppDelegateSwizzler.h>\n#import <objc/runtime.h>\n\n#import <RNFBApp/RNFBRCTEventEmitter.h>\n#import <RNFBApp/RNFBSharedUtils.h>\n#import <React/RCTConvert.h>",
        "#import <Firebase/Firebase.h>\n#import <GoogleUtilities/GULAppDelegateSwizzler.h>\n#import <RNFBApp/RCTConvert+FIRApp.h>\n#import <objc/runtime.h>\n\n#import <RNFBApp/RNFBRCTEventEmitter.h>\n#import <RNFBApp/RNFBSharedUtils.h>\n#import <React/RCTConvert.h>"
      ]
    ],
    File.join(messaging_root, 'RNFBMessaging+NSNotificationCenter.m') => [
      [
        "#import <Firebase/Firebase.h>\n#import <RNFBApp/RNFBJSON.h>\n#import <RNFBApp/RNFBRCTEventEmitter.h>\n#import <React/RCTConvert.h>",
        "#import <Firebase/Firebase.h>\n#import <RNFBApp/RCTConvert+FIRApp.h>\n#import <RNFBApp/RNFBJSON.h>\n#import <RNFBApp/RNFBRCTEventEmitter.h>\n#import <React/RCTConvert.h>"
      ]
    ],
    File.join(messaging_root, 'RNFBMessagingModule.m') => [
      [
        "#import <Firebase/Firebase.h>\n#import <RNFBApp/RNFBSharedUtils.h>\n#import <React/RCTConvert.h>\n#import <React/RCTUtils.h>",
        "#import <Firebase/Firebase.h>\n#import <RNFBApp/RCTConvert+FIRApp.h>\n#import <RNFBApp/RNFBSharedUtils.h>\n#import <React/RCTBridgeModule.h>\n#import <React/RCTConvert.h>\n#import <React/RCTDefines.h>\n#import <React/RCTUtils.h>"
      ]
    ],
    File.join(installation_root, 'Pods', 'Target Support Files', 'RNFBMessaging', 'RNFBMessaging-prefix.pch') => [
      [
        "#ifdef __OBJC__\n#import <UIKit/UIKit.h>\n#else",
        "#ifdef __OBJC__\n#import <UIKit/UIKit.h>\n#import <React/RCTDefines.h>\n#else"
      ]
    ]
  }

  replacements.each do |path, entries|
    next unless File.exist?(path)

    content = File.read(path)

    entries.each do |old_value, new_value|
      next if content.include?(new_value)
      content = content.gsub(old_value, new_value)
    end

    if path.end_with?('RNFBMessaging-prefix.pch') && !content.include?('#ifndef RCT_EXTERN')
      content << "\n#ifndef RCT_EXTERN\n#if defined(__cplusplus)\n#define RCT_EXTERN extern \"C\" __attribute__((visibility(\"default\")))\n#else\n#define RCT_EXTERN extern __attribute__((visibility(\"default\")))\n#endif\n#endif\n\n#ifndef RCT_CONCAT2\n#define RCT_CONCAT2(A, B) A##B\n#endif\n\n#ifndef RCT_CONCAT\n#define RCT_CONCAT(A, B) RCT_CONCAT2(A, B)\n#endif\n"
    end

    File.write(path, content)
  end
end

ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true'
ENV['RCT_HERMES_V1_ENABLED'] ||= '1' if podfile_properties['expo.useHermesV1'] == 'true'
platform :ios, podfile_properties['ios.deploymentTarget'] || '16.0'

prepare_react_native_project!

target 'ZICABELLA' do
  use_expo_modules!
  # Required when building with static frameworks so Swift pods can import Objective-C dependencies.
  use_modular_headers!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(\'expo/bin/autolinking\')',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )

    patch_rnfb_messaging_for_modular_headers!(Pod::Config.instance.installation_root)

    # Keep pods unsigned; the app target itself must remain signable for physical devices.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
        config.build_settings['CODE_SIGN_IDENTITY'] = ""
        config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ""
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = podfile_properties['ios.deploymentTarget'] || '16.0'
        
        # Patch for fmt library consteval errors on C++20 / Xcode 15+
        if target.name == 'fmt'
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end

    # installer.pods_project.build_configurations.each do |config|
    #   config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "arm64"
    # end

  end
end
