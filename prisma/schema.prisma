generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Shop {
  id                       String     @id @default(cuid())
  domain                   String     @unique
  accessToken              String
  installedAt              DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  delhiveryApiKey          String?
  razorpayKeyId            String?
  razorpayKeySecret        String?
  shiprocketEmail          String?
  shiprocketToken          String?
  webhookSecret            String?
  heroImage                String?
  heroVideo                String?
  heroVideoMobile          String?
  heroTitle                String?
  heroSubtitle             String?
  heroButtonText           String?    @default("Discover")
  latestCurationTitle      String?    @default("Latest curation")
  latestCurationSubtitle   String?    @default("Season Drop")
  archiveTitle             String?    @default("The Archive")
  archiveSubtitle          String?    @default("Organic Evolution")
  blueprintTitle           String?    @default("The blueprint of Zica Bella")
  blueprintSubtitle        String?    @default("Technique & Motion")
  showHeroText             Boolean    @default(false)
  showLatestCuration       Boolean    @default(true)
  showArchive              Boolean    @default(true)
  showBlueprint            Boolean    @default(true)
  showProductVideo         Boolean    @default(true)
  showSizeChart            Boolean    @default(true)
  showBrand                Boolean    @default(true)
  showShippingReturn       Boolean    @default(true)
  showCare                 Boolean    @default(true)
  showSizeFit              Boolean    @default(true)
  showDetails              Boolean    @default(true)
  pdpBackground            String?
  instagramUrl             String?
  appleUrl                 String?
  spotifyUrl               String?
  youtubeUrl               String?
  featuredMedia            String?
  collectionsMedia         String?
  footerVideo              String?
  featuredMediaMobile      String?
  featuredMediaImageMobile String?
  collectionsMediaMobile   String?
  flipbookImageMobile      String?
  flipbookVideoMobile      String?
  footerVideoMobile        String?
  mainMenuHandle           String?
  secondaryMenuHandle      String?
  showTreeText             Boolean    @default(true)
  enabledCollectionsHeader String?
  enabledCollectionsPage   String?
  enabledCollectionsMenu   String?
  featuredMediaImage       String?
  kineticMeshProducts      String?
  communitySubtitle        String?    @default("Community")
  communityTitle           String?    @default("Featured Looks")
  kineticMeshTitle         String?    @default("ARCHIVE EDITION")
  showCommunity            Boolean    @default(true)
  spotlightSubtitle        String?    @default("Luxury Indian streetwear for modern men. Redefining bold everyday style.")
  spotlightTitle           String?    @default("AUTHENTIC STREETWEAR")
  chatAccessMode           String     @default("open")
  communityAgeRestricted   Boolean    @default(true)
  communityMinOrders       Int        @default(1)
  communityWhatsAppEnabled Boolean    @default(true)
  flipbookConfig           String?    @default("[]")
  flipbookDesc             String?    @default("Engineered for those who move without compromise.")
  flipbookImage            String?
  flipbookTag              String?    @default("Core Manifest")
  flipbookTitle            String?    @default("Archival Vision")
  flipbookVideo            String?
  ringCarouselItems        String?    @default("[]")
  ringCarouselTitle        String?    @default("RING COLLECTION")
  showRingCarousel         Boolean    @default(true)
  spotlightCollection      String?    @default("tshirts")
  spotlightProducts        String?    @default("")
  shiprocketPassword       String?
  firebaseClientEmail      String?
  firebasePrivateKey       String?
  firebaseProjectId        String?
  sendgridApiKey           String?
  twilioAccountSid         String?
  twilioAuthToken          String?
  twilioPhoneNumber        String?
  whatsappPhoneId          String?
  whatsappToken            String?
  footerLogo3dUrl          String?    @default("https://cdn.shopify.com/3d/models/faaab5221b0b704c/Zicabella-logo-new22.glb")
  spotlightMedia           String?
  claudeApiKey             String?
  claudeWebhookSecret      String?
  openaiApiKey             String?
  openaiWebhookSecret      String?
  loginBgImage             String?
  loginBgVideo             String?
  loginBgImageMobile       String?
  loginBgVideoMobile       String?
  loginBgImageLight        String?
  loginBgImageDark         String?
  loginBgImageLightMobile  String?
  loginBgImageDarkMobile   String?
  featuredMediaLink        String?
  collectionsMediaLink     String?
  flipbookLink             String?
  homepageCollection       String?    @default("")
  homepageProducts         String?    @default("")
  customers                Customer[]
  orders                   Order[]
  products                 Product[]
}

model Customer {
  id                    String             @id @default(cuid())
  shopId                String
  shopifyId             String             @unique
  email                 String?
  name                  String?
  phone                 String?
  defaultAddress        String?
  ordersCount           Int                @default(0)
  totalSpent            Float              @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  image                 String?
  region                String?
  storeCredits          Float              @default(0)
  storeCreditPreference Boolean            @default(false)
  emailOptedOut         Boolean            @default(false)
  smsOptedOut           Boolean            @default(false)
  whatsappOptedOut      Boolean            @default(false)
  lastLoginAt           DateTime?
  addresses             Address[]
  cart                  Cart?
  communityMember       CommunityMember?
  communityMessages     CommunityMessage[]
  shop                  Shop               @relation(fields: [shopId], references: [id])
  following             Follow[]           @relation("UserFollowing")
  followers             Follow[]           @relation("UserFollowers")
  orders                Order[]
  payments              Payment[]
  profileHistory        ProfileHistory[]
  returns               Return[]
  storeCreditTxns       StoreCredit[]
  wishlist              Wishlist[]
  mobileOrders          MobileOrder[]
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  updatedAt  DateTime   @updatedAt
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  handle    String?
  title     String?
  price     Float?
  image     String?
  quantity  Int
  size      String?
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
}

model ProfileHistory {
  id         String   @id @default(cuid())
  customerId String
  oldName    String?
  newName    String?
  oldEmail   String?
  newEmail   String?
  oldPhone   String?
  newPhone   String?
  oldImage   String?
  newImage   String?
  changedBy  String   @default("USER")
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    Customer @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   Customer @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Order {
  id                    String            @id @default(cuid())
  shopId                String
  shopifyOrderId        String            @unique
  customerId            String
  status                String
  totalPrice            Float
  subtotalPrice         Float?
  totalTax              Float?
  currency              String            @default("INR")
  paymentStatus         String
  fulfillmentStatus     String
  deliveryStatus        String            @default("pending")
  shippingAddress       String?
  billingAddress        String?
  note                  String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  orderType             String            @default("REGULAR")
  tags                  String?
  aiRiskRecommendation  String?
  codConfirmationMethod String?
  codConfirmationStatus String?
  codConfirmedAt        DateTime?
  paymentCapturedAt     DateTime?
  paymentMethod         String?
  razorpayOrderId       String?           @unique
  razorpayPaymentId     String?           @unique
  rtoRiskFactors        String?
  rtoRiskScore          Int?
  discountAmount        Float?            @default(0)
  discountCode          String?
  exchanges             Exchange[]
  exchangeRequests      ExchangeRequest[]
  customer              Customer          @relation(fields: [customerId], references: [id])
  shop                  Shop              @relation(fields: [shopId], references: [id])
  items                 OrderItem[]
  payments              Payment[]
  returns               Return[]
  returnRequests        ReturnRequest[]
  shipments             Shipment[]
  delhivery_awb         String?
  tracking_status       String?
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  shopifyLineItemId String   @unique
  productId         String?
  title             String
  quantity          Int
  price             Float
  sku               String?
  image             String?
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product? @relation(fields: [productId], references: [id])
}

model Product {
  id                String      @id @default(cuid())
  shopId            String
  shopifyProductId  String      @unique
  title             String
  sku               String?
  barcode           String?
  inventoryItemId   String?     @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  featuredImage     String?
  handle            String?
  price             Float?
  newExchanges      Exchange[]  @relation("NewProduct")
  originalExchanges Exchange[]  @relation("OriginalProduct")
  inventory         Inventory[]
  orderItems        OrderItem[]
  shop              Shop        @relation(fields: [shopId], references: [id])
  returns           Return[]
  wishlist          Wishlist[]
  mobileOrderItems  MobileOrderItem[]
}

model Inventory {
  id               String   @id @default(cuid())
  productId        String
  locationId       String
  stockQuantity    Int      @default(0)
  reservedQuantity Int      @default(0)
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
}

model Return {
  id                String         @id @default(cuid())
  orderId           String
  productId         String
  customerId        String
  sku               String?
  reason            String
  status            String         @default("REQUESTED")
  requestedAt       DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  returnMethod      String?
  refundMethod      String?
  trackingNumber    String?
  refundAmount      Float?
  storeCreditAmount Float?
  refundStatus      String?
  returnRequestId   String?
  customer          Customer       @relation(fields: [customerId], references: [id])
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product        @relation(fields: [productId], references: [id])
  returnRequest     ReturnRequest? @relation(fields: [returnRequestId], references: [id])
}

model ReturnRequest {
  id              String    @id @default(cuid())
  orderId         String
  customerId      String
  status          String    @default("pending_approval")
  estimatedRefund Float     @default(0)
  actualRefund    Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  approvedAt      DateTime?
  reason          String?
  returns         Return[]
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Exchange {
  id                String           @id @default(cuid())
  orderId           String
  originalProductId String
  newProductId      String
  status            String           @default("REQUESTED")
  priceDifference   Float            @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  paymentStatus     String?
  newOrderId        String?
  exchangeRequestId String?
  reason            String?
  qcStatus          String?          @default("pending")
  qcNotes           String?
  exchangeRequest   ExchangeRequest? @relation(fields: [exchangeRequestId], references: [id])
  newProduct        Product          @relation("NewProduct", fields: [newProductId], references: [id])
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  originalProduct   Product          @relation("OriginalProduct", fields: [originalProductId], references: [id])
}

model ExchangeRequest {
  id               String     @id @default(cuid())
  orderId          String
  customerId       String
  status           String     @default("pending_approval")
  priceDifference  Float      @default(0)
  paymentStatus    String     @default("not_required")
  paymentId        String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  reason           String?
  returnRequestId  String?
  newShopifyOrderId String?
  exchanges        Exchange[]
  order            Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id         String   @id @default(cuid())
  orderId    String
  customerId String
  amount     Float
  type       String
  status     String
  gateway    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Shipment {
  id                   String    @id @default(cuid())
  orderId              String
  trackingNumber       String?
  courier              String?
  status               String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  trackingUrl          String?
  currentLocation      String?
  estimatedDelivery    DateTime?
  events               String?   @default("[]")
  awb                  String?   @unique
  labelUrl             String?
  rawDelhiveryResponse String?
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id          String    @id @default(cuid())
  source      String
  eventType   String
  payload     String
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([source, eventType])
  @@index([createdAt])
}

model FeaturedUser {
  id               String   @id @default(cuid())
  orderId          String?
  name             String
  email            String
  imageUrl         String
  styleDescription String?
  isTopFeatured    Boolean  @default(false)
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  instagramUrl     String?
  reviews          Review[]
}

model Review {
  id             String       @id @default(cuid())
  featuredUserId String
  reviewerName   String
  rating         Int          @default(5)
  comment        String?
  status         String       @default("APPROVED")
  createdAt      DateTime     @default(now())
  featuredUser   FeaturedUser @relation(fields: [featuredUserId], references: [id], onDelete: Cascade)
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String?
  content    String
  coverImage String?
  published  Boolean  @default(false)
  author     String   @default("Zica Bella")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CommunityMember {
  id            String    @id @default(cuid())
  customerId    String    @unique
  isVerified    Boolean   @default(false)
  status        String    @default("PENDING")
  phone         String?
  dob           DateTime?
  whatsappOptIn Boolean   @default(false)
  joinedAt      DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer  @relation(fields: [customerId], references: [id])
}

model CommunityUpdate {
  id          String    @id @default(cuid())
  type        String    @default("EVENT")
  title       String
  description String?
  imageUrl    String?
  date        DateTime?
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CommunityMessage {
  id         String         @id @default(cuid())
  customerId String
  content    String
  imageUrl   String?
  createdAt  DateTime       @default(now())
  reactions  ChatReaction[]
  customer   Customer       @relation(fields: [customerId], references: [id])
}

model ChatReaction {
  id         String           @id @default(cuid())
  messageId  String
  customerId String
  emoji      String           @default("❤️")
  createdAt  DateTime         @default(now())
  message    CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, customerId, emoji])
}

model ScanRecord {
  id           String   @id @default(cuid())
  productId    String?
  productTitle String?
  variantInfo  String?
  sku          String?
  barcode      String?
  actionType   String
  quantity     Int      @default(1)
  beforeStock  Int?
  afterStock   Int?
  locationId   String?
  staffName    String   @default("Admin")
  createdAt    DateTime @default(now())
}

model MfgFabric {
  id                      String               @id @default(cuid())
  sku                     String               @unique
  name                    String
  costPerMeter            Float
  weightValue             Float                @default(0)
  weightUnit              String               @default("kg")
  totalMeters             Float                @default(0)
  status                  String               @default("ACTIVE")
  lowStockMetersThreshold Float?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  movements               MfgFabricMovement[]
  productionBatches       MfgProductionBatch[]
}

model MfgFabricMovement {
  id                 String              @id @default(cuid())
  fabricId           String
  occurredAt         DateTime            @default(now())
  type               String
  quantity           Float
  quantityUnit       String
  rateAtMovement     Float
  totalValue         Float
  remarks            String?
  createdByName      String              @default("Admin")
  correctsMovementId String?
  productionBatchId  String?
  balanceMetersAfter Float?
  balanceWeightAfter Float?
  createdAt          DateTime            @default(now())
  fabric             MfgFabric           @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  batch              MfgProductionBatch? @relation(fields: [productionBatchId], references: [id])

  @@index([fabricId, occurredAt])
  @@index([productionBatchId])
}

model MfgProductionBatch {
  id                   String                  @id @default(cuid())
  batchCode            String                  @unique @map("batch_code")
  productName          String                  @map("product_name")
  quantity             Int
  currentStage         String                  @map("current_stage")
  washCostTotal        Float                   @default(0) @map("wash_cost_total")
  fabricId             String?                 @map("fabric_id")
  notes                String?
  estimatedCostPerUnit Float?                  @map("estimated_cost_per_unit")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  isCuttingDone        Boolean                 @default(false) @map("is_cutting_done")
  isEmbroideryDone     Boolean                 @default(false) @map("is_embroidery_done")
  isPrintingDone       Boolean                 @default(false) @map("is_printing_done")
  isSampleDone         Boolean                 @default(false) @map("is_sample_done")
  isWashingDone        Boolean                 @default(false) @map("is_washing_done")
  isStitchingDone      Boolean                 @default(false) @map("is_stitching_done")
  batchNotes           MfgBatchNote[]
  movements            MfgFabricMovement[]
  miscExpenses         MfgMiscExpense[]
  fabric               MfgFabric?              @relation(fields: [fabricId], references: [id])
  stageLogs            MfgProductionStageLog[]
  tasks                MfgTask[]
  workdriveFolderId    String?                 @map("workdrive_folder_id")
  workdriveFolderName  String?                 @map("workdrive_folder_name")
  workdriveUrl         String?                 @map("workdrive_url")

  @@map("manufacturing_batches")
}

model MfgTask {
  id                String              @id @default(cuid())
  title             String
  description       String?
  status            String              @default("PENDING")
  priority          String              @default("MEDIUM")
  dueDate           DateTime?           @map("due_date")
  completedAt       DateTime?           @map("completed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  createdByName     String              @default("Admin") @map("created_by_name")
  batchId           String?             @map("batch_id")
  batch             MfgProductionBatch? @relation(fields: [batchId], references: [id])
  type              String              @default("MANUAL")
  assignedToId      String?             @map("assigned_to_id")
  assignedTo        User?               @relation("TaskAssignee", fields: [assignedToId], references: [id])
  workdriveUrl      String?             @map("workdrive_url")
  workdriveFolderId String?             @map("workdrive_folder_id")
  workdriveFolderName String?           @map("workdrive_folder_name")
  approvalStatus    String?             @map("approval_status")
  designName        String?             @map("design_name")
  designImage       String?             @map("design_image")

  @@map("pending_tasks")
}

model MfgProductionStageLog {
  id            String             @id @default(cuid())
  batchId       String
  action        String
  fromStage     String?
  toStage       String?
  payload       Json
  costAmount    Float              @default(0)
  createdByName String
  createdAt     DateTime           @default(now())
  batch         MfgProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, createdAt])
}

model MfgMiscExpense {
  id            String              @id @default(cuid())
  batchId       String?
  amount        Float
  description   String
  expenseType   String              @default("OTHER")
  expenseDate   DateTime
  createdByName String
  createdAt     DateTime            @default(now())
  batch         MfgProductionBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model MfgBatchNote {
  id            String             @id @default(cuid())
  batchId       String
  content       String
  createdByName String
  createdAt     DateTime           @default(now())
  batch         MfgProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, createdAt])
}

model MfgAuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  details    Json?
  actorName  String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model MfgVendor {
  id              String                    @id @default(cuid())
  name            String
  address         String?
  mobile          String?
  category        String
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  contactPerson   String?                   @map("contact_person")
  email           String?
  pricingNotes    String?                   @map("pricing_notes")
  leadTimeDays    Int?                      @map("lead_time_days")
  remarks         String?
  samples         MfgSample[]
  kbEntries       MfgProductKnowledgeBase[] @relation("KBVendor")
}

model MfgDesignTask {
  id                  String    @id @default(cuid())
  title               String
  description         String?
  orderId             String?   @map("order_id")
  status              String    @default("draft")
  workdriveFolderId   String?   @map("workdrive_folder_id")
  workdriveFolderName String?   @map("workdrive_folder_name")
  approvedFileId      String?   @map("approved_file_id")
  approvedById        String?   @map("approved_by")
  approvedBy          User?     @relation("DesignApprover", fields: [approvedById], references: [id])
  approvedAt          DateTime? @map("approved_at")
  createdById         String?   @map("created_by")
  createdBy           User?     @relation("DesignCreator", fields: [createdById], references: [id])
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([orderId])
  @@map("design_tasks")
}

model StoreCredit {
  id              String    @id @default(cuid())
  customerId      String
  amount          Float
  type            String
  description     String
  orderId         String?
  returnId        String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  remainingAmount Float     @default(0)
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String
  fcmToken   String
  apnsToken  String?
  platform   String   @default("ios")
  appVersion String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([userId, isActive])
  @@index([fcmToken])
}

model NotificationSend {
  id             String    @id @default(cuid())
  title          String
  body           String
  imageUrl       String?
  data           String?
  targetType     String
  targetValue    String?
  deepLinkType   String?
  deepLinkId     String?
  scheduledAt    DateTime?
  sentAt         DateTime?
  status         String    @default("draft")
  sentCount      Int       @default(0)
  deliveredCount Int       @default(0)
  openedCount    Int       @default(0)
  failedCount    Int       @default(0)
  createdBy      String    @default("admin")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([createdAt])
}

model WhatsAppMessage {
  id           String    @id @default(cuid())
  direction    String
  waMessageId  String?   @unique
  phoneNumber  String
  userId       String?
  templateName String?
  body         String?
  mediaUrl     String?
  mediaType    String?
  status       String    @default("sent")
  campaignId   String?
