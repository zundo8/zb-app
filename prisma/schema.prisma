  @@map("mfg_samples")
}

model MfgSampleImage {
  id         String    @id @default(cuid())
  sampleId   String    @map("sample_id")
  sample     MfgSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  imageUrl   String    @map("image_url")
  uploadedAt DateTime  @default(now()) @map("uploaded_at")

  @@map("mfg_sample_images")
}

model MfgSampleRevision {
  id               String    @id @default(cuid())
  sampleId         String    @map("sample_id")
  sample           MfgSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  revisionNumber   Int       @map("revision_number")
  changeRequests   String    @map("change_requests")
  designerResponse String?   @map("designer_response")
  resubmissionDate DateTime? @map("resubmission_date")
  approvalDate     DateTime? @map("approval_date")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("mfg_sample_revisions")
}

model MfgProductKnowledgeBase {
  id               String     @id @default(cuid())
  styleCode        String     @unique @map("style_code")
  productName      String     @map("product_name")
  designerId       String?    @map("designer_id")
  designer         User?      @relation("KBDesigner", fields: [designerId], references: [id])
  fabricUsed       String?    @map("fabric_used")
  gsm              String?
  composition      String?
  printingTechnique String?   @map("printing_technique")
  vendorId         String?    @map("vendor_id")
  vendor           MfgVendor? @relation("KBVendor", fields: [vendorId], references: [id])
  accessoriesUsed  String?    @map("accessories_used")
  sampleImages     String[]   @map("sample_images")
  productionNotes  String?    @map("production_notes")
  approvalDate     DateTime?  @map("approval_date")
  createdAt        DateTime   @default(now()) @map("created_at")

  @@map("mfg_product_knowledge_base")
}

model MfgEmployeePerformance {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation("EmployeePerf", fields: [userId], references: [id])
  eventType     String   @map("event_type")
  scoreDelta    Float    @map("score_delta")
  referenceId   String?  @map("reference_id")
  referenceType String?  @map("reference_type")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("mfg_employee_performance")
}

