generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Shop {
  id                       String     @id @default(cuid())
  domain                   String     @unique
  accessToken              String
  installedAt              DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  delhiveryApiKey          String?
  razorpayKeyId            String?
  razorpayKeySecret        String?
  shiprocketEmail          String?
  shiprocketPassword       String?
  shiprocketToken          String?
  webhookSecret            String?
  whatsappPhoneId          String?
  whatsappToken            String?
  firebaseProjectId        String?
  firebaseClientEmail      String?
  firebasePrivateKey       String?
  sendgridApiKey           String?
  twilioAccountSid         String?
  twilioAuthToken          String?
  twilioPhoneNumber        String?
  heroImage                String?
  heroVideo                String?
  heroTitle                String?
  heroSubtitle             String?
  heroButtonText           String?    @default("Discover")
  latestCurationTitle      String?    @default("Latest curation")
  latestCurationSubtitle   String?    @default("Season Drop")
  archiveTitle             String?    @default("The Archive")
  archiveSubtitle          String?    @default("Organic Evolution")
  blueprintTitle           String?    @default("The blueprint of Zica Bella")
  blueprintSubtitle        String?    @default("Technique & Motion")
  showHeroText             Boolean    @default(false)
  showLatestCuration       Boolean    @default(true)
  showArchive              Boolean    @default(true)
  showBlueprint            Boolean    @default(true)
  showProductVideo         Boolean    @default(true)
  showSizeChart            Boolean    @default(true)
  showBrand                Boolean    @default(true)
  showShippingReturn       Boolean    @default(true)
  showCare                 Boolean    @default(true)
  showSizeFit              Boolean    @default(true)
  showDetails              Boolean    @default(true)
  pdpBackground            String?
  instagramUrl             String?
  appleUrl                 String?
  spotifyUrl               String?
  youtubeUrl               String?
  featuredMedia            String?
  collectionsMedia         String?
  footerVideo              String?
  mainMenuHandle           String?
  secondaryMenuHandle      String?
  showTreeText             Boolean    @default(true)
  enabledCollectionsHeader String?
  enabledCollectionsPage   String?
  enabledCollectionsMenu   String?
  featuredMediaImage       String?
  kineticMeshProducts      String?
  communitySubtitle        String?    @default("Community")
  communityTitle           String?    @default("Featured Looks")
  kineticMeshTitle         String?    @default("ARCHIVE EDITION")
  showCommunity            Boolean    @default(true)
  spotlightSubtitle        String?    @default("Luxury Indian streetwear for modern men. Redefining bold everyday style.")
  spotlightTitle           String?    @default("AUTHENTIC STREETWEAR")
  spotlightCollection      String?    @default("tshirts")
  spotlightProducts        String?    @default("")
  chatAccessMode           String     @default("open")
  communityAgeRestricted   Boolean    @default(true)
  communityMinOrders       Int        @default(1)
  communityWhatsAppEnabled Boolean    @default(true)
  flipbookConfig           String?    @default("[]")
  flipbookDesc             String?    @default("Engineered for those who move without compromise.")
  flipbookImage            String?
  flipbookTag              String?    @default("Core Manifest")
  flipbookTitle            String?    @default("Archival Vision")
  flipbookVideo            String?
  ringCarouselItems        String?    @default("[]")
  ringCarouselTitle        String?    @default("RING COLLECTION")
  showRingCarousel         Boolean    @default(true)
  customers                Customer[]
  orders                   Order[]
  products                 Product[]
}

model Customer {
  id                    String             @id @default(cuid())
  shopId                String
  shopifyId             String             @unique
  email                 String?
  name                  String?
  phone                 String?
  defaultAddress        String?
  ordersCount           Int                @default(0)
  totalSpent            Float              @default(0)
  storeCredits          Float              @default(0)
  storeCreditPreference Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  image                 String?
  region                String?
  communityMember       CommunityMember?
  communityMessages     CommunityMessage[]
  shop                  Shop               @relation(fields: [shopId], references: [id])
  following             Follow[]           @relation("UserFollowing")
  followers             Follow[]           @relation("UserFollowers")
  orders                Order[]
  payments              Payment[]
  returns               Return[]
  storeCreditTxns       StoreCredit[]
  whatsappOptedOut      Boolean            @default(false)
  emailOptedOut         Boolean            @default(false)
  smsOptedOut           Boolean            @default(false)
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    Customer @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   Customer @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Order {
  id                  String      @id @default(cuid())
  shopId              String
  shopifyOrderId      String      @unique
  customerId          String
  status              String
  orderType           String      @default("REGULAR") // REGULAR, RETURN, EXCHANGE
  totalPrice          Float
  subtotalPrice       Float?
  totalTax            Float?
  currency            String      @default("INR")
  paymentStatus       String
  fulfillmentStatus   String
  deliveryStatus      String      @default("pending")
  shippingAddress     String?
  billingAddress      String?
  note                String?
  tags                String?
  razorpayOrderId     String?     @unique
  razorpayPaymentId   String?     @unique
  paymentMethod       String?
  paymentCapturedAt   DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  exchanges           Exchange[]
  customer            Customer    @relation(fields: [customerId], references: [id])
  shop                Shop        @relation(fields: [shopId], references: [id])
  items               OrderItem[]
  payments            Payment[]
  returns             Return[]
  shipments           Shipment[]
  codConfirmationStatus String?     // pending, confirmed, cancelled, timed_out
  codConfirmedAt      DateTime?
  codConfirmationMethod String?   // whatsapp_button, sms_reply, manual_admin, auto
  rtoRiskScore        Int?
  rtoRiskFactors      String?     // JSON array of risk factors
  aiRiskRecommendation String?
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  shopifyLineItemId String   @unique
  productId         String?
  title             String
  quantity          Int
  price             Float
  sku               String?
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product? @relation(fields: [productId], references: [id])
}

model Product {
  id                String      @id @default(cuid())
  shopId            String
  shopifyProductId  String      @unique
  title             String
  sku               String?
  barcode           String?
  inventoryItemId   String?     @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  newExchanges      Exchange[]  @relation("NewProduct")
  originalExchanges Exchange[]  @relation("OriginalProduct")
  inventory         Inventory[]
  orderItems        OrderItem[]
  shop              Shop        @relation(fields: [shopId], references: [id])
  returns           Return[]
}

model Inventory {
  id               String   @id @default(cuid())
  productId        String
  locationId       String
  stockQuantity    Int      @default(0)
  reservedQuantity Int      @default(0)
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
}

model Return {
  id                String   @id @default(cuid())
  orderId           String
  productId         String
  customerId        String
  sku               String?
  reason            String
  status            String   @default("REQUESTED") // REQUESTED, APPROVED, RECEIVED, REFUNDED, REJECTED
  returnMethod      String?  // PICKUP, DROP_OFF
  refundMethod      String?  // ORIGINAL, STORE_CREDIT
  trackingNumber    String?
  refundAmount      Float?
  storeCreditAmount Float?
  refundStatus      String?  // PENDING, COMPLETED, FAILED
  requestedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
  customer          Customer @relation(fields: [customerId], references: [id])
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id])
}

model Exchange {
  id                String   @id @default(cuid())
  orderId           String
  originalProductId String
  newProductId      String
  status            String   @default("REQUESTED") // REQUESTED, APPROVED, SHIPPED, DELIVERED, REJECTED
  priceDifference   Float    @default(0)
  paymentStatus     String?  // PENDING, COMPLETED
  newOrderId        String?  // Link to the new order created for the exchange
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  newProduct        Product  @relation("NewProduct", fields: [newProductId], references: [id])
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  originalProduct   Product  @relation("OriginalProduct", fields: [originalProductId], references: [id])
}

model Payment {
  id         String   @id @default(cuid())
  orderId    String
  customerId String
  amount     Float
  type       String
  status     String
  gateway    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Shipment {
  id                   String   @id @default(cuid())
  orderId              String
  trackingNumber       String?
  awb                  String?  @unique
  trackingUrl          String?
  courier              String?
  status               String
  currentLocation      String?
  estimatedDelivery    DateTime?
  labelUrl             String?
  rawDelhiveryResponse String?  // JSON string of full API response
  events               String?  @default("[]") // JSON array of { status, location, timestamp, description }
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id          String    @id @default(cuid())
  source      String    // 'razorpay' or 'delhivery'
  eventType   String
  payload     String    // JSON string of the full webhook payload
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([source, eventType])
  @@index([createdAt])
}

model FeaturedUser {
  id               String   @id @default(cuid())
  orderId          String?
  name             String
  email            String
  imageUrl         String
  styleDescription String?
  isTopFeatured    Boolean  @default(false)
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  instagramUrl     String?
  reviews          Review[]
}

model Review {
  id             String       @id @default(cuid())
  featuredUserId String
  reviewerName   String
  rating         Int          @default(5)
  comment        String?
  status         String       @default("APPROVED")
  createdAt      DateTime     @default(now())
  featuredUser   FeaturedUser @relation(fields: [featuredUserId], references: [id], onDelete: Cascade)
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String?
  content    String
  coverImage String?
  published  Boolean  @default(false)
  author     String   @default("Zica Bella")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CommunityMember {
  id            String    @id @default(cuid())
  customerId    String    @unique
  isVerified    Boolean   @default(false)
  status        String    @default("PENDING")
  phone         String?
  dob           DateTime?
  whatsappOptIn Boolean   @default(false)
  joinedAt      DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer  @relation(fields: [customerId], references: [id])
}

model CommunityUpdate {
  id          String    @id @default(cuid())
  type        String    @default("EVENT")
  title       String
  description String?
  imageUrl    String?
  date        DateTime?
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CommunityMessage {
  id         String         @id @default(cuid())
  customerId String
  content    String
  imageUrl   String?
  createdAt  DateTime       @default(now())
  reactions  ChatReaction[]
  customer   Customer       @relation(fields: [customerId], references: [id])
}

model ChatReaction {
  id         String           @id @default(cuid())
  messageId  String
  customerId String
  emoji      String           @default("❤️")
  createdAt  DateTime         @default(now())
  message    CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, customerId, emoji])
}

model ScanRecord {
  id           String   @id @default(cuid())
  productId    String?
  productTitle String?
  variantInfo  String?
  sku          String?
  barcode      String?
  actionType   String
  quantity     Int      @default(1)
  beforeStock  Int?
  afterStock   Int?
  locationId   String?
  staffName    String   @default("Admin")
  createdAt    DateTime @default(now())
}

// --- Manufacturing module (isolated from shop products/orders) ---

model MfgFabric {
  id                      String               @id @default(cuid())
  sku                     String               @unique
  name                    String
  costPerMeter            Float
  weightValue             Float                @default(0)
  weightUnit              String               @default("kg")
  totalMeters             Float                @default(0)
  status                  String               @default("ACTIVE")
  lowStockMetersThreshold Float?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  movements               MfgFabricMovement[]
  productionBatches       MfgProductionBatch[]
}

model MfgFabricMovement {
  id                 String              @id @default(cuid())
  fabricId           String
  fabric             MfgFabric           @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  occurredAt         DateTime            @default(now())
  type               String
  quantity           Float
  quantityUnit       String
  rateAtMovement     Float
  totalValue         Float
  remarks            String?
  createdByName      String              @default("Admin")
  correctsMovementId String?
  productionBatchId  String?
  batch              MfgProductionBatch? @relation(fields: [productionBatchId], references: [id], onDelete: SetNull)
  balanceMetersAfter Float?
  balanceWeightAfter Float?
  createdAt          DateTime            @default(now())

  @@index([fabricId, occurredAt])
  @@index([productionBatchId])
}

model MfgProductionBatch {
  id                   String                  @id @default(cuid())
  batchCode            String                  @unique
  productName          String
  quantity             Int
  currentStage         String
  isSampleDone         Boolean                 @default(false)
  isCuttingDone        Boolean                 @default(false)
  isStitchingDone      Boolean                 @default(false)
  isPrintingDone       Boolean                 @default(false)
  isEmbroideryDone     Boolean                 @default(false)
  isWashingDone        Boolean                 @default(false)
  washCostTotal        Float                   @default(0)
  fabricId             String?
  fabric               MfgFabric?              @relation(fields: [fabricId], references: [id], onDelete: SetNull)
  notes                String?
  estimatedCostPerUnit Float?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  movements            MfgFabricMovement[]
  stageLogs            MfgProductionStageLog[]
  miscExpenses         MfgMiscExpense[]
  batchNotes           MfgBatchNote[]
  tasks                MfgTask[]
}

model MfgTask {
  id            String              @id @default(cuid())
  title         String
  description   String?
  status        String              @default("PENDING") // PENDING, COMPLETED, CANCELLED
  priority      String              @default("MEDIUM")  // LOW, MEDIUM, HIGH
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdByName String              @default("Admin")
  batchId       String?
  batch         MfgProductionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
}

model MfgProductionStageLog {
  id            String               @id @default(cuid())
  batchId       String
  batch         MfgProductionBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  action        String
  fromStage     String?
  toStage       String?
  payload       Json
  costAmount    Float                @default(0)
  createdByName String
  createdAt     DateTime             @default(now())

  @@index([batchId, createdAt])
}

model MfgMiscExpense {
  id            String              @id @default(cuid())
  batchId       String?
  batch         MfgProductionBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  amount        Float
  description   String
  expenseType   String              @default("OTHER")
  expenseDate   DateTime
  createdByName String
  createdAt     DateTime            @default(now())

  @@index([batchId])
}

model MfgBatchNote {
  id            String             @id @default(cuid())
  batchId       String
  batch         MfgProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  content       String
  createdByName String
  createdAt     DateTime           @default(now())

  @@index([batchId, createdAt])
}

model MfgAuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  details    Json?
  actorName  String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model MfgVendor {
  id        String   @id @default(cuid())
  name      String
  address   String?
  mobile    String?
  category  String   // Fabric, Buttons, Threads, Screen Printing, Digital Printing, Washing, Embroidery, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Store Credits (for refund-as-credit and checkout usage) ---

model StoreCredit {
  id          String   @id @default(cuid())
  customerId  String
  amount      Float
  type        String   // CREDIT, DEBIT
  description String
  orderId     String?
  returnId    String?
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

// ═══════════════════════════════════════════════════════
// NOTIFICATIONS & MARKETING MODULE
// ═══════════════════════════════════════════════════════

// --- Device Token Registry (M1: Push Notifications) ---

model DeviceToken {
  id          String   @id @default(cuid())
  userId      String   // Maps to Customer.id or external user id
  deviceId    String   // Unique device identifier
  fcmToken    String
  apnsToken   String?
  platform    String   @default("ios") // ios, android
  appVersion  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([userId, isActive])
  @@index([fcmToken])
}

// --- Notification Send Log (M1) ---

model NotificationSend {
  id           String   @id @default(cuid())
  title        String
  body         String
  imageUrl     String?
  data         String?  // JSON payload: { type, orderId, productHandle, etc. }
  targetType   String   // all, segment, user
  targetValue  String?  // segment name or userId
  deepLinkType String?  // none, order, product, promo
  deepLinkId   String?
  scheduledAt  DateTime?
  sentAt       DateTime?
  status       String   @default("draft") // draft, scheduled, sending, sent, failed
  sentCount    Int      @default(0)
  deliveredCount Int    @default(0)
  openedCount  Int      @default(0)
  failedCount  Int      @default(0)
  createdBy    String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([createdAt])
}

// --- WhatsApp Messages (M3: WhatsApp Marketing) ---

model WhatsAppMessage {
  id            String   @id @default(cuid())
  direction     String   // inbound, outbound
  waMessageId   String?  @unique // WhatsApp message ID
  phoneNumber   String
  userId        String?  // Customer id if matched
  templateName  String?
  body          String?
  mediaUrl      String?
  mediaType     String?  // image, video, document
  status        String   @default("sent") // sent, delivered, read, failed
  campaignId    String?
  orderId       String?
  errorCode     String?
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phoneNumber, createdAt])
  @@index([userId])
  @@index([campaignId])
  @@index([status])
}

// --- WhatsApp Campaigns (M3) ---

model WhatsAppCampaign {
  id                  String   @id @default(cuid())
  name                String
  templateName        String
  templateParams      String?  // JSON: parameter schema
  targetSegment       String   @default("all") // all, new, repeat, vip, cart_abandon
  scheduledAt         DateTime?
  sentAt              DateTime?
  status              String   @default("draft") // draft, scheduled, sending, sent, failed
  createdBy           String   @default("admin")
  statsSent           Int      @default(0)
  statsDelivered      Int      @default(0)
  statsRead           Int      @default(0)
  statsReplied        Int      @default(0)
  statsFailed         Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, scheduledAt])
}

// --- Email Campaigns (M4) ---

model EmailCampaign {
  id              String   @id @default(cuid())
  name            String
  subject         String
  previewText     String?
  htmlContent     String   @db.Text
  plainText       String?  @db.Text
  fromName        String?  @default("Zica Bella")
  targetSegment   String   @default("all")
  scheduledAt     DateTime?
  sentAt          DateTime?
  status          String   @default("draft") // draft, scheduled, sending, sent, failed
  createdBy       String   @default("admin")
  statsSent       Int      @default(0)
  statsOpened     Int      @default(0)
  statsClicked    Int      @default(0)
  statsBounced    Int      @default(0)
  statsUnsubscribed Int    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, scheduledAt])
}

// --- SMS Campaigns (M5) ---

model SmsCampaign {
  id              String   @id @default(cuid())
  name            String
  messageBody     String   // max 160 chars
  targetSegment   String   @default("all")
  scheduledAt     DateTime?
  sentAt          DateTime?
  status          String   @default("draft") // draft, scheduled, sending, sent, failed
  createdBy       String   @default("admin")
  statsSent       Int      @default(0)
  statsDelivered  Int      @default(0)
  statsFailed     Int      @default(0)
  dltTemplateId   String?  // DLT registered template ID for India
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, scheduledAt])
}

// --- Campaign Analytics Events (M4/M7: Open/Click Tracking) ---

model CampaignAnalyticsEvent {
  id          String   @id @default(cuid())
  channel     String   // email, whatsapp, sms, push
  campaignId  String
  userId      String?
  eventType   String   // open, click, reply, unsubscribe, bounce, delivered
  metadata    String?  // JSON: { url, linkText, etc. }
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([channel, campaignId, eventType])
  @@index([userId, channel])
  @@index([createdAt])
}
