generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Shop {
  id                       String     @id @default(cuid())
  domain                   String     @unique
  accessToken              String
  installedAt              DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  delhiveryApiKey          String?
  razorpayKeyId            String?
  razorpayKeySecret        String?
  shiprocketEmail          String?
  shiprocketToken          String?
  webhookSecret            String?
  heroImage                String?
  heroVideo                String?
  heroTitle                String?
  heroSubtitle             String?
  heroButtonText           String?    @default("Discover")
  latestCurationTitle      String?    @default("Latest curation")
  latestCurationSubtitle   String?    @default("Season Drop")
  archiveTitle             String?    @default("The Archive")
  archiveSubtitle          String?    @default("Organic Evolution")
  blueprintTitle           String?    @default("The blueprint of Zica Bella")
  blueprintSubtitle        String?    @default("Technique & Motion")
  showHeroText             Boolean    @default(false)
  showLatestCuration       Boolean    @default(true)
  showArchive              Boolean    @default(true)
  showBlueprint            Boolean    @default(true)
  showProductVideo         Boolean    @default(true)
  showSizeChart            Boolean    @default(true)
  showBrand                Boolean    @default(true)
  showShippingReturn       Boolean    @default(true)
  showCare                 Boolean    @default(true)
  showSizeFit              Boolean    @default(true)
  showDetails              Boolean    @default(true)
  pdpBackground            String?
  instagramUrl             String?
  appleUrl                 String?
  spotifyUrl               String?
  youtubeUrl               String?
  featuredMedia            String?
  collectionsMedia         String?
  footerVideo              String?
  mainMenuHandle           String?
  secondaryMenuHandle      String?
  showTreeText             Boolean    @default(true)
  enabledCollectionsHeader String?
  enabledCollectionsPage   String?
  enabledCollectionsMenu   String?
  featuredMediaImage       String?
  kineticMeshProducts      String?
  communitySubtitle        String?    @default("Community")
  communityTitle           String?    @default("Featured Looks")
  kineticMeshTitle         String?    @default("ARCHIVE EDITION")
  showCommunity            Boolean    @default(true)
  spotlightSubtitle        String?    @default("Luxury Indian streetwear for modern men. Redefining bold everyday style.")
  spotlightTitle           String?    @default("AUTHENTIC STREETWEAR")
  chatAccessMode           String     @default("open")
  communityAgeRestricted   Boolean    @default(true)
  communityMinOrders       Int        @default(1)
  communityWhatsAppEnabled Boolean    @default(true)
  flipbookConfig           String?    @default("[]")
  flipbookDesc             String?    @default("Engineered for those who move without compromise.")
  flipbookImage            String?
  flipbookTag              String?    @default("Core Manifest")
  flipbookTitle            String?    @default("Archival Vision")
  flipbookVideo            String?
  ringCarouselItems        String?    @default("[]")
  ringCarouselTitle        String?    @default("RING COLLECTION")
  showRingCarousel         Boolean    @default(true)
  spotlightCollection      String?    @default("tshirts")
  spotlightProducts        String?    @default("")
  shiprocketPassword       String?
  firebaseClientEmail      String?
  firebasePrivateKey       String?
  firebaseProjectId        String?
  sendgridApiKey           String?
  twilioAccountSid         String?
  twilioAuthToken          String?
  twilioPhoneNumber        String?
  whatsappPhoneId          String?
  whatsappToken            String?
  footerLogo3dUrl          String?    @default("https://cdn.shopify.com/3d/models/faaab5221b0b704c/Zicabella-logo-new22.glb")
  spotlightMedia           String?
  claudeApiKey             String?
  claudeWebhookSecret      String?
  openaiApiKey             String?
  openaiWebhookSecret      String?
  homepageCollection       String?    @default("")
  homepageProducts         String?    @default("")
  customers                Customer[]
  orders                   Order[]
  products                 Product[]
}

model Customer {
  id                    String             @id @default(cuid())
  shopId                String
  shopifyId             String             @unique
  email                 String?
  name                  String?
  phone                 String?
  defaultAddress        String?
  ordersCount           Int                @default(0)
  totalSpent            Float              @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  image                 String?
  region                String?
  storeCredits          Float              @default(0)
  storeCreditPreference Boolean            @default(false)
  emailOptedOut         Boolean            @default(false)
  smsOptedOut           Boolean            @default(false)
  whatsappOptedOut      Boolean            @default(false)
  lastLoginAt           DateTime?
  addresses             Address[]
  cart                  Cart?
  communityMember       CommunityMember?
  communityMessages     CommunityMessage[]
  shop                  Shop               @relation(fields: [shopId], references: [id])
  following             Follow[]           @relation("UserFollowing")
  followers             Follow[]           @relation("UserFollowers")
  orders                Order[]
  payments              Payment[]
  profileHistory        ProfileHistory[]
  returns               Return[]
  storeCreditTxns       StoreCredit[]
  wishlist              Wishlist[]
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  updatedAt  DateTime   @updatedAt
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  handle    String?
  title     String?
  price     Float?
  image     String?
  quantity  Int
  size      String?
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
}

model ProfileHistory {
  id         String   @id @default(cuid())
  customerId String
  oldName    String?
  newName    String?
  oldEmail   String?
  newEmail   String?
  oldPhone   String?
  newPhone   String?
  oldImage   String?
  newImage   String?
  changedBy  String   @default("USER")
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    Customer @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   Customer @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Order {
  id                    String            @id @default(cuid())
  shopId                String
  shopifyOrderId        String            @unique
  customerId            String
  status                String
  totalPrice            Float
  subtotalPrice         Float?
  totalTax              Float?
  currency              String            @default("INR")
  paymentStatus         String
  fulfillmentStatus     String
  deliveryStatus        String            @default("pending")
  shippingAddress       String?
  billingAddress        String?
  note                  String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  orderType             String            @default("REGULAR")
  tags                  String?
  aiRiskRecommendation  String?
  codConfirmationMethod String?
  codConfirmationStatus String?
  codConfirmedAt        DateTime?
  paymentCapturedAt     DateTime?
  paymentMethod         String?
  razorpayOrderId       String?           @unique
  razorpayPaymentId     String?           @unique
  rtoRiskFactors        String?
  rtoRiskScore          Int?
  discountAmount        Float?            @default(0)
  discountCode          String?
  exchanges             Exchange[]
  exchangeRequests      ExchangeRequest[]
  customer              Customer          @relation(fields: [customerId], references: [id])
  shop                  Shop              @relation(fields: [shopId], references: [id])
  items                 OrderItem[]
  payments              Payment[]
  returns               Return[]
  returnRequests        ReturnRequest[]
  shipments             Shipment[]
  delhivery_awb         String?
  tracking_status       String?
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  shopifyLineItemId String   @unique
  productId         String?
  title             String
  quantity          Int
  price             Float
  sku               String?
  image             String?
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product? @relation(fields: [productId], references: [id])
}

model Product {
  id                String      @id @default(cuid())
  shopId            String
  shopifyProductId  String      @unique
  title             String
  sku               String?
  barcode           String?
  inventoryItemId   String?     @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  featuredImage     String?
  handle            String?
  price             Float?
  newExchanges      Exchange[]  @relation("NewProduct")
  originalExchanges Exchange[]  @relation("OriginalProduct")
  inventory         Inventory[]
  orderItems        OrderItem[]
  shop              Shop        @relation(fields: [shopId], references: [id])
  returns           Return[]
  wishlist          Wishlist[]
}

model Inventory {
  id               String   @id @default(cuid())
  productId        String
  locationId       String
  stockQuantity    Int      @default(0)
  reservedQuantity Int      @default(0)
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
}

model Return {
  id                String         @id @default(cuid())
  orderId           String
  productId         String
  customerId        String
  sku               String?
  reason            String
  status            String         @default("REQUESTED")
  requestedAt       DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  returnMethod      String?
  refundMethod      String?
  trackingNumber    String?
  refundAmount      Float?
  storeCreditAmount Float?
  refundStatus      String?
  returnRequestId   String?
  customer          Customer       @relation(fields: [customerId], references: [id])
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product        @relation(fields: [productId], references: [id])
  returnRequest     ReturnRequest? @relation(fields: [returnRequestId], references: [id])
}

model ReturnRequest {
  id              String    @id @default(cuid())
  orderId         String
  customerId      String
  status          String    @default("pending_approval")
  estimatedRefund Float     @default(0)
  actualRefund    Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  approvedAt      DateTime?
  reason          String?
  returns         Return[]
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Exchange {
  id                String           @id @default(cuid())
  orderId           String
  originalProductId String
  newProductId      String
  status            String           @default("REQUESTED")
  priceDifference   Float            @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  paymentStatus     String?
  newOrderId        String?
  exchangeRequestId String?
  reason            String?
  qcStatus          String?          @default("pending")
  qcNotes           String?
  exchangeRequest   ExchangeRequest? @relation(fields: [exchangeRequestId], references: [id])
  newProduct        Product          @relation("NewProduct", fields: [newProductId], references: [id])
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  originalProduct   Product          @relation("OriginalProduct", fields: [originalProductId], references: [id])
}

model ExchangeRequest {
  id               String     @id @default(cuid())
  orderId          String
  customerId       String
  status           String     @default("pending_approval")
  priceDifference  Float      @default(0)
  paymentStatus    String     @default("not_required")
  paymentId        String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  reason           String?
  returnRequestId  String?
  newShopifyOrderId String?
  exchanges        Exchange[]
  order            Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id         String   @id @default(cuid())
  orderId    String
  customerId String
  amount     Float
  type       String
  status     String
  gateway    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Shipment {
  id                   String    @id @default(cuid())
  orderId              String
  trackingNumber       String?
  courier              String?
  status               String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  trackingUrl          String?
  currentLocation      String?
  estimatedDelivery    DateTime?
  events               String?   @default("[]")
  awb                  String?   @unique
  labelUrl             String?
  rawDelhiveryResponse String?
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id          String    @id @default(cuid())
  source      String
  eventType   String
  payload     String
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([source, eventType])
  @@index([createdAt])
}

model FeaturedUser {
  id               String   @id @default(cuid())
  orderId          String?
  name             String
  email            String
  imageUrl         String
  styleDescription String?
  isTopFeatured    Boolean  @default(false)
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  instagramUrl     String?
  reviews          Review[]
}

model Review {
  id             String       @id @default(cuid())
  featuredUserId String
  reviewerName   String
  rating         Int          @default(5)
  comment        String?
  status         String       @default("APPROVED")
  createdAt      DateTime     @default(now())
  featuredUser   FeaturedUser @relation(fields: [featuredUserId], references: [id], onDelete: Cascade)
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String?
  content    String
  coverImage String?
  published  Boolean  @default(false)
  author     String   @default("Zica Bella")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CommunityMember {
  id            String    @id @default(cuid())
  customerId    String    @unique
  isVerified    Boolean   @default(false)
  status        String    @default("PENDING")
  phone         String?
  dob           DateTime?
  whatsappOptIn Boolean   @default(false)
  joinedAt      DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer  @relation(fields: [customerId], references: [id])
}

model CommunityUpdate {
  id          String    @id @default(cuid())
  type        String    @default("EVENT")
  title       String
  description String?
  imageUrl    String?
  date        DateTime?
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CommunityMessage {
  id         String         @id @default(cuid())
  customerId String
  content    String
  imageUrl   String?
  createdAt  DateTime       @default(now())
  reactions  ChatReaction[]
  customer   Customer       @relation(fields: [customerId], references: [id])
}

model ChatReaction {
  id         String           @id @default(cuid())
  messageId  String
  customerId String
  emoji      String           @default("❤️")
  createdAt  DateTime         @default(now())
  message    CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, customerId, emoji])
}

model ScanRecord {
  id           String   @id @default(cuid())
  productId    String?
  productTitle String?
  variantInfo  String?
  sku          String?
  barcode      String?
  actionType   String
  quantity     Int      @default(1)
  beforeStock  Int?
  afterStock   Int?
  locationId   String?
  staffName    String   @default("Admin")
  createdAt    DateTime @default(now())
}

model MfgFabric {
  id                      String               @id @default(cuid())
  sku                     String               @unique
  name                    String
  costPerMeter            Float
  weightValue             Float                @default(0)
  weightUnit              String               @default("kg")
  totalMeters             Float                @default(0)
  status                  String               @default("ACTIVE")
  lowStockMetersThreshold Float?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  movements               MfgFabricMovement[]
  productionBatches       MfgProductionBatch[]
}

model MfgFabricMovement {
  id                 String              @id @default(cuid())
  fabricId           String
  occurredAt         DateTime            @default(now())
  type               String
  quantity           Float
  quantityUnit       String
  rateAtMovement     Float
  totalValue         Float
  remarks            String?
  createdByName      String              @default("Admin")
  correctsMovementId String?
  productionBatchId  String?
  balanceMetersAfter Float?
  balanceWeightAfter Float?
  createdAt          DateTime            @default(now())
  fabric             MfgFabric           @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  batch              MfgProductionBatch? @relation(fields: [productionBatchId], references: [id])

  @@index([fabricId, occurredAt])
  @@index([productionBatchId])
}

model MfgProductionBatch {
  id                   String                  @id @default(cuid())
  batchCode            String                  @unique
  productName          String
  quantity             Int
  currentStage         String
  washCostTotal        Float                   @default(0)
  fabricId             String?
  notes                String?
  estimatedCostPerUnit Float?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  isCuttingDone        Boolean                 @default(false)
  isEmbroideryDone     Boolean                 @default(false)
  isPrintingDone       Boolean                 @default(false)
  isSampleDone         Boolean                 @default(false)
  isWashingDone        Boolean                 @default(false)
  isStitchingDone      Boolean                 @default(false)
  batchNotes           MfgBatchNote[]
  movements            MfgFabricMovement[]
  miscExpenses         MfgMiscExpense[]
  fabric               MfgFabric?              @relation(fields: [fabricId], references: [id])
  stageLogs            MfgProductionStageLog[]
  tasks                MfgTask[]
}

model MfgTask {
  id            String              @id @default(cuid())
  title         String
  description   String?
  status        String              @default("PENDING")
  priority      String              @default("MEDIUM")
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdByName String              @default("Admin")
  batchId       String?
  batch         MfgProductionBatch? @relation(fields: [batchId], references: [id])
}

model MfgProductionStageLog {
  id            String             @id @default(cuid())
  batchId       String
  action        String
  fromStage     String?
  toStage       String?
  payload       Json
  costAmount    Float              @default(0)
  createdByName String
  createdAt     DateTime           @default(now())
  batch         MfgProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, createdAt])
}

model MfgMiscExpense {
  id            String              @id @default(cuid())
  batchId       String?
  amount        Float
  description   String
  expenseType   String              @default("OTHER")
  expenseDate   DateTime
  createdByName String
  createdAt     DateTime            @default(now())
  batch         MfgProductionBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model MfgBatchNote {
  id            String             @id @default(cuid())
  batchId       String
  content       String
  createdByName String
  createdAt     DateTime           @default(now())
  batch         MfgProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, createdAt])
}

model MfgAuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  details    Json?
  actorName  String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model MfgVendor {
  id        String   @id @default(cuid())
  name      String
  address   String?
  mobile    String?
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreCredit {
  id          String   @id @default(cuid())
  customerId  String
  amount      Float
  type        String
  description String
  orderId     String?
  returnId    String?
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String
  fcmToken   String
  apnsToken  String?
  platform   String   @default("ios")
  appVersion String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([userId, isActive])
  @@index([fcmToken])
}

model NotificationSend {
  id             String    @id @default(cuid())
  title          String
  body           String
  imageUrl       String?
  data           String?
  targetType     String
  targetValue    String?
  deepLinkType   String?
  deepLinkId     String?
  scheduledAt    DateTime?
  sentAt         DateTime?
  status         String    @default("draft")
  sentCount      Int       @default(0)
  deliveredCount Int       @default(0)
  openedCount    Int       @default(0)
  failedCount    Int       @default(0)
  createdBy      String    @default("admin")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([createdAt])
}

model WhatsAppMessage {
  id           String   @id @default(cuid())
  direction    String
  waMessageId  String?  @unique
  phoneNumber  String
  userId       String?
  templateName String?
  body         String?
  mediaUrl     String?
  mediaType    String?
  status       String   @default("sent")
  campaignId   String?
  orderId      String?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([phoneNumber, createdAt])
  @@index([userId])
  @@index([campaignId])
  @@index([status])
}

model WhatsAppCampaign {
  id             String    @id @default(cuid())
  name           String
  templateName   String
  templateParams String?
  targetSegment  String    @default("all")
  scheduledAt    DateTime?
  sentAt         DateTime?
  status         String    @default("draft")
  createdBy      String    @default("admin")
  statsSent      Int       @default(0)
  statsDelivered Int       @default(0)
  statsRead      Int       @default(0)
  statsReplied   Int       @default(0)
  statsFailed    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, scheduledAt])
}

model EmailCampaign {
  id                String    @id @default(cuid())
  name              String
  subject           String
  previewText       String?
  htmlContent       String
  plainText         String?
  fromName          String?   @default("Zica Bella")
  targetSegment     String    @default("all")
  scheduledAt       DateTime?
  sentAt            DateTime?
  status            String    @default("draft")
  createdBy         String    @default("admin")
  statsSent         Int       @default(0)
  statsOpened       Int       @default(0)
  statsClicked      Int       @default(0)
  statsBounced      Int       @default(0)
  statsUnsubscribed Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, scheduledAt])
}

model SmsCampaign {
  id             String    @id @default(cuid())
  name           String
  messageBody    String
  targetSegment  String    @default("all")
  scheduledAt    DateTime?
  sentAt         DateTime?
  status         String    @default("draft")
  createdBy      String    @default("admin")
  statsSent      Int       @default(0)
  statsDelivered Int       @default(0)
  statsFailed    Int       @default(0)
  dltTemplateId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, scheduledAt])
}

model CampaignAnalyticsEvent {
  id         String   @id @default(cuid())
  channel    String
  campaignId String
  userId     String?
  eventType  String
  metadata   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([channel, campaignId, eventType])
  @@index([userId, channel])
  @@index([createdAt])
}

model Discount {
  id             String    @id @default(cuid())
  code           String    @unique
  type           String    @default("percentage")
  value          Float
  minOrderAmount Float     @default(0)
  maxDiscount    Float?
  startDate      DateTime  @default(now())
  endDate        DateTime?
  usageLimit     Int?
  usageCount     Int       @default(0)
  isActive       Boolean   @default(true)
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

model VerificationCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model AppLogin {
  id        String   @id @default(cuid())
  phone     String
  status    String   @default("SUCCESS")
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([createdAt])
}

model Policy {
  id        String   @id @default(cuid())
  handle    String   @unique
  title     String
  content   String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model EmailLog {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  recipientEmail String
  recipientName  String?
  subject        String
  templateName   String
  triggerEvent   String?
  referenceId    String?
  status         String   @default("sent")
  messageId      String?
  errorMessage   String?
  sentBy         String   @default("system")

  @@index([recipientEmail])
  @@index([createdAt])
  @@index([templateName])
}

model EmailTemplate {
  id                String       @id @default(cuid())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  name              String
  category          String
  subject           String
  htmlBody          String
  variables         Json?
  isActive          Boolean      @default(true)
  createdBy         String?
  automationTrigger String?
  EmailDraft        EmailDraft[]

  @@index([category])
  @@index([automationTrigger])
}

model EmailNotificationPreference {
  id        String   @id @default(cuid())
  eventKey  String   @unique
  label     String
  isEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model EmailDraft {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  subject      String?
  toRecipients Json?
  cc           String?
  bcc          String?
  htmlBody     String?
  templateId   String?
  scheduledAt  DateTime?
  createdBy    String?
  template     EmailTemplate? @relation(fields: [templateId], references: [id])

  @@index([templateId])
}

model Wishlist {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  name       String?
  phone      String?
  email      String?
  address1   String
  address2   String?
  city       String
  state      String
  zip        String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model SupportTicket {
  id         String           @id @default(cuid())
  customerId String?
  guestName  String?
  guestEmail String?
  subject    String
  status     String           @default("OPEN")
  priority   String           @default("MEDIUM")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  messages   SupportMessage[]
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  senderType String        @default("USER")
  senderId   String?
  senderName String?
  content    String
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model User {
  id                  String       @id @default(cuid())
  email               String       @unique
  passwordHash        String
  name                String?
  role                Role         @default(ADMIN)
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  createdBy           String?
  failedLoginAttempts Int          @default(0)
  lockUntil           DateTime?
  needsPasswordChange Boolean      @default(false)
  auditLogs           AuditLog[]
  permissions         Permission[]
  creator             User?        @relation("UserCreator", fields: [createdBy], references: [id])
  createdUsers        User[]       @relation("UserCreator")
}

model Permission {
  id        String  @id @default(cuid())
  userId    String
  module    Module
  canView   Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  module    String?
  targetId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([timestamp])
}

model AIChatSession {
  id        String          @id @default(cuid())
  userId    String?
  title     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  AIChatMessage[]

  @@index([userId])
}

model AIChatMessage {
  id        String        @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime      @default(now())
  session   AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum Module {
  DASHBOARD_HOME
  SUPPORT
  ORDERS
  MOBILE_ORDERS
  CUSTOMERS
  PRODUCTS
  INVENTORY
  LOGISTICS
  RETURNS_EXCHANGES
  STOREFRONT
  COMMUNITY
  MARKETING
  MANUFACTURING
  FINANCIAL
  INTEGRATIONS
  AI_SERVICES
  SETTINGS
  ADMIN_USERS
  AUDIT_LOG
}

model ZicaAiCache {
  id                   String   @id @default(uuid())
  userId               String
  sessionId            String
  turnIndex            Int
  userMessage          String
  aiResponse           String   @db.Text
  detectedProducts     String[]
  detectedCollections  String[]
  intentTags           String[]
  sentiment            String
  timestamp            DateTime @default(now())
  responseTokens       Int
  helpfulFlag          Boolean?

  @@index([userId, timestamp])
}

model ZicaAiGlobalInsight {
  id               String   @id @default(uuid())
  insightType      String
  key              String
  frequency        Int      @default(1)
  lastSeen         DateTime @default(now())
  sampleQueries    String[]
  confidenceScore  Float    @default(0.0)

  @@unique([insightType, key])
}

model ZicaUserProfile {
  userId             String   @id
  preferredCategories String[]
  preferredSizes     String[]
  styleTags          String[]
  totalSessions      Int      @default(0)
  lastActive         DateTime @default(now())
  favouriteProducts  String[]
}
